# ============================================================
# Econ Paper Studio - 环境变量模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env: Copy-Item .env.example .env
#   2. 填入下面的 API Keys
#   3. .env 文件已被 .gitignore 忽略，不会被误提交
# ============================================================

# 【可选】Volcengine 火山方舟 API Key（用于 verify 阶段调用 doubao-vision 检查表/图）
# 获取：https://console.volcengine.com/ark
ARK_API_KEY=

# 【可选】Semantic Scholar API Key（用于阶段 5 引用验证）
# 获取：https://www.semanticscholar.org/product/api （免费）
SEMANTIC_SCHOLAR_API_KEY=

# 【可选】FRED API Key（用于阶段 1/3 拉取美国宏观数据）
# 获取：https://fredaccount.stlouisfed.org/apikeys （免费）
FRED_API_KEY=

# 【可选】OpenAlex Email（识别身份避免限流）
# 用法：在请求 header 加 User-Agent: mailto:your_email
OPENALEX_EMAIL=

# 【可选】Stata 路径（如果你装了 Stata 17+，启用 stata-mcp）
# Windows 默认：C:\Program Files\Stata18\StataSE-64.exe
# macOS 默认：/Applications/Stata/StataSE.app/Contents/MacOS/StataSE
STATA_PATH=

# 【可选】默认输出目录
ECON_STUDIO_OUTPUT_DIR=./outputs

# 【可选】默认日志级别
ECON_STUDIO_LOG_LEVEL=INFO
